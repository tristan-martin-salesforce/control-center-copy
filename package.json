{
  "name": "command-center",
  "version": "2.0.0",
  "private": true,
  "description": "Local personal-ops cockpit for Salesforce sellers (Solutions Engineers, Specialist AEs). Nothing leaves without approval.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/ops/migrate-state.mjs --quiet && node scripts/sync-brand-assets.mjs",
    "predev:web": "node scripts/ops/migrate-state.mjs --quiet",
    "preworker": "node scripts/ops/migrate-state.mjs --quiet",
    "dev": "concurrently -k -n web,worker -c blue,magenta \"npm:dev:web\" \"npm:worker\"",
    "dev:web": "next dev -H 127.0.0.1 -p ${PORT:-4327}",
    "worker": "tsx watch src/worker/index.ts",
    "worker:start": "tsx src/worker/index.ts",
    "prebuild": "node scripts/sync-brand-assets.mjs",
    "build": "next build",
    "build:release": "node scripts/release/build.mjs",
    "start": "next start -H 127.0.0.1 -p ${PORT:-4327}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --project ui",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --project ui",
    "test:watch": "vitest",
    "check:fast": "npm run typecheck && npm run lint && npm test",
    "check": "npm run check:fast && npm run test:db && npm run test:evals",
    "contrast": "node scripts/contrast.mjs",
    "shot": "node scripts/shot.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio --port 4985",
    "seed:example": "tsx scripts/build-example-seed.ts",
    "gen:routes": "tsx scripts/gen-api-routes.ts",
    "test:db": "vitest run --project 'db*' --maxWorkers=1",
    "test:db:core": "vitest run --project db-core --maxWorkers=1",
    "test:db:worker": "vitest run --project db-worker --maxWorkers=1",
    "test:db:datasource": "vitest run --project db-datasource --maxWorkers=1",
    "test:db:reeval": "vitest run --project db-reeval --maxWorkers=1",
    "test:db:retention": "vitest run --project db-retention --maxWorkers=1",
    "doctor": "tsx src/ops/doctor.ts",
    "load:guard": "node scripts/dev/load-guard.mjs",
    "usage:guard": "node scripts/dev/usage-guard.mjs",
    "setup": "node scripts/ops/setup.mjs",
    "ops:install": "node scripts/ops/install.mjs",
    "ops:rollback": "node scripts/ops/rollback.mjs",
    "ops:uninstall": "node scripts/ops/uninstall-agents.mjs",
    "backup": "node scripts/ops/backup.mjs",
    "restore": "node scripts/ops/restore.mjs",
    "update": "node scripts/ops/update.mjs",
    "release": "node scripts/release.mjs",
    "release:outbox": "tsx scripts/release/outbox.ts",
    "seed:real": "tsx scripts/seed/build-real-seed.ts",
    "test:be0": "npm run test:db:core",
    "test:be1a": "npm run test:db:worker",
    "test:be1b": "npm run test:db:datasource",
    "test:bereeval": "npm run test:db:reeval",
    "test:bechat": "vitest run --project db tests/db/chat",
    "test:beoutbox": "vitest run --project db tests/db/outbox",
    "test:evals": "vitest run --project evals",
    "test:a11y": "tsx tests/a11y/axe-pages.ts --port 4434",
    "smoke:crawl": "tsx scripts/test/crawl.ts",
    "eval:record": "tsx scripts/eval/record.ts",
    "db:retention": "tsx scripts/db/retention.ts",
    "db:read-profile": "tsx scripts/db/read-profile.ts",
    "db:backfill": "tsx scripts/db/backfill.ts",
    "db:seed": "tsx scripts/db/seed-from-mock.ts",
    "db:bootstrap": "tsx scripts/db/bootstrap.ts",
    "scan:trace": "tsx scripts/scan/trace.ts",
    "scan:explain": "tsx scripts/scan/explain.ts",
    "scan:report": "tsx scripts/scan/report.ts",
    "scan:private": "tsx scripts/private/scan.ts",
    "vdp:scan": "tsx scripts/vdp/scan.ts",
    "voice:profile": "tsx scripts/voice/cli.ts",
    "time:rederive": "tsx scripts/time-rederive.ts",
    "crawl": "node scripts/qa/crawl.mjs",
    "sample:build": "tsx sample-data/build-all.ts",
    "sample:load": "tsx scripts/sample-data/load.ts",
    "sample:validate": "tsx scripts/sample-data/validate.ts",
    "sample:lint": "tsx scripts/sample-data/lint.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-virtual": "^3.14.25",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-mention": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "isomorphic-dompurify": "^3.18.0",
    "lucide-react": "^1.66.0",
    "marked": "^15.0.12",
    "nanoid": "^6.0.2",
    "next": "^15.5.19",
    "pg": "^8.21.0",
    "pino": "^9.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "zod": "^3.25.76",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@salesforce-ux/icons": "10.18.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "axe-core": "4.14.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk": {
      "zod": "$zod"
    },
    "@anthropic-ai/sdk": {
      "zod": "$zod"
    }
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "17.12.0-beta.19",
    "@embedded-postgres/darwin-x64": "17.12.0-beta.19"
  }
}
